; Initialization
i = 1
timeout = 5

; LOG's name setting:
logautoclosemode 1    ; if Macro關閉, log就關閉
gettime logTimestr "log_%Y%m%d_%H%M%S.log"    ; log後綴, "時間戳記"
logNamestr = "IE12_ContinuousUDP_"    ; !!!!請輸入: "此腳本用途名稱"
sprintf2 logFileName '%s%s' logNamestr logTimestr
dispstr logFileName #10 #13    ; ^^^^ for debug
logopen logFileName 0 1 0 1
;logopen <檔名> <換行符號> <接續編寫> <純文字> <時間> <隱藏記錄框>

; DUT_COM_port setting:
inputbox "Please enter your DUT-Modem COM port:" "DUT-Modem COM port"
DUT_COMport = inputstr
sprintf2 Conn_DUT_COMport "/C=%s" DUT_COMport

; Test_round setting:
inputbox "How many TEST ROUNDS would you like to repeat:" "Test Round"
testRnd = inputstr
str2int int_testRnd testRnd




; # 0. 連線DUT
connect Conn_DUT_COMport

; 動作迴圈: "連線+指令輸入"
for i 1 int_testRnd

    connect Conn_DUT_COMport    ; !!!!! You must first "CONNECT" then script will be run,
    sprintf2 testRoundstr "==== Test Round %i : ====" i
    dispstr testRoundstr #10 #13


    ; # 0a. 上步的果, DUT連線狀態檢查
    connect Conn_DUT_COMport    ;!!!!
    linkStatusInt = result    ; (先將連線結果,存起來)
    if linkStatusInt == 2 then    ; 連線狀態=2: BOTH "Connection" OK & "Link" OK
        ; 提示連線狀態
        sprintf2 linkStatusPrompt2 "===Test Round %i===  LinkStatus=%d: COM connected successfully.  Begin to test..." i linkStatusInt
        statusbox linkStatusPrompt2 'Connection Status'
        dispstr linkStatusPrompt2 #10 #13  ;13CR,10LF
        dispstr #10 #13
    elseif linkStatusInt == 1 then    ; 連線狀態=1: "Connection (to HOST)" XX  but  "Link (to Tera)" OK)
        sprintf2 linkStatusPrompt1 "LinkStatus=%d. COM connection failed." linkStatusInt
        statusbox linkStatusPrompt1 'Connection Status'
        dispstr linkStatusPrompt1 #10 #10 #13

    endif


    ; !!!! 指令輸入code block !!!! 
    ; 1. Disable Protocol Notifications (URCs)
    dispstr ">> 1. Disable Protocol Notifications (URCs)" #10 #13
    sendln 'AT+KURCCFG="UDP",0,0'
    mpause 250
    waitln 'OK'
    ; Error handling:
    if result == 0 then
        sprintf2 errorMessage "->Error happened. Record to log; Disconnect, then continue to next round."
        statusbox errorMessage 'Error'   ;box顯示
        dispstr errorMessage #10 #13 #10 #13
        ; disconnect
        closesbox
    endif
    dispstr #10 #13
    
    ; 2. Configure UDP connection
    dispstr ">> 2a. Start a UDP port#10002(toListen) + Connect to 127.0.0.1(localhost) port#10001" #10 #13
    sendln 'AT+KUDPCFG=1,1,10002,0,"127.0.0.1",10001'
    mpause 250
    waitln 'OK'
    ; Error handling:
    if result == 0 then
        sprintf2 errorMessage "->Error happened. Record to log; Disconnect, then continue to next round."
        statusbox errorMessage 'Error'   ;box顯示
        dispstr errorMessage #10 #13 #10 #13
        ; disconnect
        closesbox
    endif
    dispstr ">> 2b. Start a UDP port#10001(toListen) + Connect to 127.0.0.1(localhost) port#10002" #10 #13
    sendln 'AT+KUDPCFG=1,0,10001,1,"127.0.0.1",10002'
    mpause 250
    waitln 'OK'
    ; Error handling:
    if result == 0 then
        sprintf2 errorMessage "->Error happened. Record to log; Disconnect, then continue to next round."
        statusbox errorMessage 'Error'   ;box顯示
        dispstr errorMessage #10 #13 #10 #13
        ; disconnect
        closesbox
    endif
    dispstr #10 #13

    ; 3a. Send data through UDP connection
    dispstr ">> 3. Send data through UDP connection" #10 #13
    sendln 'AT+KUDPSND=1,,,4'
    mpause 250
    waitln 'CONNECT'
    ; Error handling:
    if result == 0 then
        sprintf2 errorMessage "->Error happened. Record to log; Disconnect, then continue to next round."
        statusbox errorMessage 'Error'   ;box顯示
        dispstr errorMessage #10 #13 #10 #13
        ; disconnect
        closesbox
    endif
    ; dispstr #10 #13
    ; 3b. Input Data
    send '31323334'    ; 不可以用sendln,尾巴有LF/CR也會傳入socket
    mpause 250
    waitln 'OK'
    ; Error handling:
    if result == 0 then
        sprintf2 errorMessage "->Error happened. Record to log; Disconnect, then continue to next round."
        statusbox errorMessage 'Error'   ;box顯示
        dispstr errorMessage #10 #13 #10 #13
        ; disconnect
        closesbox
    endif
    dispstr #10 #13

    ; 4. Receive data through UDP connection
    dispstr ">> 4. Receive data through UDP connection" #10 #13
    sendln 'AT+KUDPRCV=2,4'
    mpause 250
    waitln 'OK'
    ; Error handling:
    if result == 0 then
        sprintf2 errorMessage "->Error happened. Record to log; Disconnect, then continue to next round."
        statusbox errorMessage 'Error'   ;box顯示
        dispstr errorMessage #10 #13 #10 #13
        ; disconnect
        closesbox
    endif
    dispstr #10 #13

    ; 5. Close current UDP connection
    dispstr ">> 5. Close current UDP connection" #10 #13
    sendln 'AT+KUDPCLOSE=1'    ; Close session #1
    mpause 250
    waitln 'OK'
    ; Error handling:
    if result == 0 then
        sprintf2 errorMessage "->Error happened. Record to log; Disconnect, then continue to next round."
        statusbox errorMessage 'Error'   ;box顯示
        dispstr errorMessage #10 #13 #10 #13
        ; disconnect
        closesbox
    endif
    dispstr #10 #13
    sendln 'AT+KUDPCLOSE=2'    ; Close session #2
    mpause 250
    waitln 'OK'
    ; Error handling:
    if result == 0 then
        sprintf2 errorMessage "->Error happened. Record to log; Disconnect, then continue to next round."
        statusbox errorMessage 'Error'   ;box顯示
        dispstr errorMessage #10 #13 #10 #13
        ; disconnect
        closesbox
    endif
    dispstr #10 #13

    ; 6. Delete configured UDP session
    dispstr ">> 6. Delete configured UDP session" #10 #13
    sendln 'AT+KUDPDEL=1'    ; Delete session #1
    mpause 250
    waitln 'OK'
    ; Error handling:
    if result == 0 then
        sprintf2 errorMessage "->Error happened. Record to log; Disconnect, then continue to next round."
        statusbox errorMessage 'Error'   ;box顯示
        dispstr errorMessage #10 #13 #10 #13
        ; disconnect
        closesbox
    endif
    dispstr #10 #13
    sendln 'AT+KUDPDEL=2'    ; Delete session #2
    mpause 250
    waitln 'OK'
    ; Error handling:
    if result == 0 then
        sprintf2 errorMessage "->Error happened. Record to log; Disconnect, then continue to next round."
        statusbox errorMessage 'Error'   ;box顯示
        dispstr errorMessage #10 #13 #10 #13
        ; disconnect
        closesbox
    endif
    dispstr #10 #13
      
    ; 7. Get UDP connection
    dispstr ">> 7. Get UDP connection" #10 #13
    sendln 'AT+KUDPcfg?'
    mpause 250
    waitln 'OK'
    ; Error handling:
    if result == 0 then
        sprintf2 errorMessage "->Error happened. Record to log; Disconnect, then continue to next round."
        statusbox errorMessage 'Error'   ;box顯示
        dispstr errorMessage #10 #13 #10 #13
        ; disconnect
        closesbox
    endif
    dispstr #10 #13

    ; Routine Check: check if Reset happened or not 
    dispstr "System Check" #10 #13
    sendln 'AT!GStatus?'
    mpause 250
    waitln 'OK'
    ; Error handling:
    if result == 0 then
        sprintf2 errorMessage "->Error happened. Record to log; Disconnect, then continue to next round."
        statusbox errorMessage 'Error'   ;box顯示
        dispstr errorMessage #10 #13 #10 #13
        ; disconnect
        closesbox
    endif
    dispstr #10 #13

next
    


; stop marco
messagebox "Test finished. Marco will be closed." "Message"
dispstr "Test finished. Macro will be closed." #10 #10 #13
end



; !!!!! "goto" can NOT use to break loop
; !!!!! You must first "CONNECT" then script will be run, otherwise that part will be ignored.

