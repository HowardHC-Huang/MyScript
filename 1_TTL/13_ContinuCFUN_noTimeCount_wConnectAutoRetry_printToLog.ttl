;    0a. Initialization
i = 1
timeout = 5

;    0b. LOG's file name setting:
logautoclosemode 1    ; if Macro關閉, log就關閉
gettime logTimestr "log_%Y%m%d_%H%M%S.log"    ; log後綴, "時間戳記"
logNamestr = "IE13_CFUN1and0_"    ; !!!!請輸入: "此腳本用途名稱"
sprintf2 logFileName '%s%s' logNamestr logTimestr
dispstr logFileName #10 #13    ; ^^^^ display for debug

logopen logFileName 0 1 0 1    ;logopen <檔名> <換行符號> <接續編寫> <純文字> <時間> <隱藏記錄框>


;    0c. DUT_COM_port setting:
inputbox "Please enter your DUT-Modem COM port:" "DUT-Modem COM port"
DUT_COMport = inputstr
sprintf2 Conn_DUT_COMport "/C=%s" DUT_COMport


;    0d. Test_round setting:
inputbox "How many TEST ROUNDS would you like to repeat:" "Test Round"
testRnd = inputstr
str2int int_testRnd testRnd


;    #1. 連線至DUT
connect Conn_DUT_COMport

; "指令輸入"迴圈
for i 1 int_testRnd

    connect Conn_DUT_COMport    ; !!!! You must first "CONNECT" then script will be run...(被迫加這行)
    sprintf2 testRoundstr "== Test Round %i : ==" i
    dispstr testRoundstr #10 #13


    ; # 0a. 上步的果, DUT連線狀態檢查
    connect Conn_DUT_COMport    ;!!!!
    linkStatusInt = result    ; (先將連線結果,存起來)
	
    if linkStatusInt == 2 then    ; 連線狀態=2: BOTH "Connection" OK & "Link" OK
    ; 提示連線狀態
    sprintf2 linkStatusPrompt2 "LinkStatus:%d: COM connected successfully. Start testing now..." linkStatusInt
    statusbox linkStatusPrompt2 'Connection Status'
    dispstr linkStatusPrompt2 #10 #13  ;13CR,10LF
    
    elseif linkStatusInt == 1 then    ; 連線狀態=1: "Connection (to HOST)" XX  but  "Link (to Tera)" OK)
        sprintf2 linkStatusPrompt1 "LinkStatus:%d: COM can NOT be connected." linkStatusInt
        statusbox linkStatusPrompt1 'Connection Status'
        dispstr linkStatusPrompt1 #10 #10 #13

    endif




    ; !!!! 開始輸入指令 !!!!
    ; 1. Set Phone Functionality to Minimum "AT+CFUN=0"
    ; 若無AT!reset請略過此行: pause 10  ;下AT!reset後:port斷需約9sec; 開機後:可連(port通)需約25sec, 可收(收ATcmd)需約35sec
    dispstr "1. Setting CFUN=0" #10 #13
    sendln 'AT+CFUN=0'
    mpause 2000
    waitln 'OK'
    ; Error handling:
    if result == 0 then
        sprintf2 errorMessage "-> FAILED: AT+CFUN=0 didn't return OK. Record to log; Continue to next round."
        statusbox errorMessage 'Error' ;box顯示
        dispstr errorMessage #10 #13 #10 #13
        closesbox
    endif
    dispstr #10 #13


    ; 1a. Check with CIMI (Expect ERROR in CFUN=0)
    dispstr "1a. Check with AT+CIMI in CFUN=0" #10 #13
    sendln 'AT+CIMI'
    waitln 'ERROR'  ; 等待 ERROR 被回傳
    if result == 0 then
        dispstr "-> FAILED: AT+CIMI didn't return ERROR, under CFUN=0" #10 #13 #10 #13
    endif
    dispstr #10 #13


    ; 2. Set Phone Functionality to Full "AT+CFUN=1"
    dispstr "2. Setting CFUN=1" #10 #13
    sendln 'AT+CFUN=1'
    mpause 2000    ; CFUN=1 涉及射頻開啟，通常建議等待稍長
    waitln 'OK'
    ; Error handling:
    if result == 0 then
        sprintf2 errorMessage "-> FAILED: AT+CFUN=1 didn't return OK. Record to log; Continue to next round."
        statusbox errorMessage 'Error' ;box顯示
        dispstr errorMessage #10 #13 #10 #13
		closesbox
    endif
    dispstr #10 #13


	; 2a. Check with CIMI (Expect OK in CFUN=1)
    dispstr "2a. Check with AT+CIMI in CFUN=1" #10 #13
    sendln 'AT+CIMI'
    waitln 'OK'  ; 等待 OK 被回傳
    if result == 0 then
        dispstr "-> FAILED: AT+CIMI didn't return OK, under CFUN=1" #10 #13 #10 #13
    endif
    dispstr #10 #13
    
next
    

; stop marco
messagebox "Test finished. Marco will be closed." "Message"
dispstr "Test finished. Macro will be closed." #10 #10 #13
end




